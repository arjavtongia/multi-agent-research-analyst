# Copy to .env and fill in what you need. Empty values fall back to the defaults in
# src/research_agents/config.py.

# --- LLM provider: nvidia (default), azure, openai, anthropic ------------------------------
LLM_PROVIDER=
# Optional overrides of the main and the fast (high-volume extraction) model.
LLM_MODEL=
LLM_FAST_MODEL=
LLM_MAX_OUTPUT_TOKENS=

# Only the key for your provider is needed. Free NVIDIA key: https://build.nvidia.com
NVIDIA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_FAST_DEPLOYMENT=

# --- Web search: auto (Tavily if TAVILY_API_KEY is set, else DuckDuckGo), duckduckgo, tavily --
SEARCH_PROVIDER=
TAVILY_API_KEY=
# ddgs backend: duckduckgo (default) or auto (metasearch across several engines)
DDGS_BACKEND=

# --- Limits and guardrails ----------------------------------------------------------------
# Defaults: 2 revisions, 3 sources per sub-question, 300000 tokens per run.
MAX_REVISIONS=
MAX_SOURCES_PER_QUESTION=
TOKEN_BUDGET=

# --- Optional LangSmith tracing (no code changes needed) ----------------------------------
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
